# Environment Variables Template

# OpenAI API Key for AI briefings
OPENAI_API_KEY=your_openai_api_key_here

# JWT Secret for authentication
JWT_SECRET=nexara-super-secret-jwt-key-change-in-production

# Database Configuration (for future PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/nexara

# News API Key (for future real news integration)
NEWS_API_KEY=your_news_api_key_here

# Fuel API Configuration
FUEL_API_KEY=your_fuel_api_key_here

# Redis URL (for future caching)
REDIS_URL=redis://localhost:6379

# Application Environment
NODE_ENV=development